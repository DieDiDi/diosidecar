{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["types-md.d.ts", "main/**/*.ts", "drawio/**/*.ts", "core/types.ts", "core/i18n.ts", "core/custom-agent.ts", "core/agent/**/*.ts", "core/locales/**/*.ts", "core/ui/**/*.ts"]
}
